<?xml version="1.0" encoding="utf-8"?>
<!--
    Kinetic Notes does not yet have a validated portable backup/restore format.
    Keep Android's automatic backup from copying the Room database, note files or
    preferences until an explicit, integrity-checked export exists (I-016).
    This is a privacy/data-integrity guard, not a substitute for user backup.
-->
<full-backup-content>
    <exclude domain="database" path="." />
    <exclude domain="file" path="." />
    <exclude domain="sharedpref" path="." />
    <exclude domain="external" path="." />
    <exclude domain="root" path="." />
</full-backup-content>
